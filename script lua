    WebhookName = "Dreyvid hub-Finder",
    WebhookAvatar = "https://media.discordapp.net/attachments/1560449770089218168/1560659102663970876/Imagen_de_Codex_26_sept_2026_14_27_56.png?ex=6ad3848d&is=6ad2330d&hm=702b230abd0fa184816081aa8e02d4a0edca7ff25209b17f2651113e3854cc7e&=&format=webp&quality=lossless&width=1024&height=1024",
    FooterText = "Drey Hub | Finder | discord.gg/dbkShvQGHf",
    Webhooks = {
        { Name = "10 M/s a 500 M/s", Url = "https://discord.com/api/webhooks/1560450586242195487/TTDLC0G8FacFVW0SmiBezfS7RMhroE-hQlYYmwHycV7F4rq1wmavrgoErWv5yAyd3D8p" },
        { Name = "500 M/s o más", Url = "https://discord.com/api/webhooks/1558542287750037585/LZIBkA8ixTNF8h-K6LRfuHdQjwkQbl6cw2mvdBNCOECfmfPQSXK7BlDLVMHuu4eaDXBG" },
        { Name = "Información", Url = "https://discord.com/api/webhooks/1560450713534857287/l_d25EDgkRNw2RAbL2bSwqU3Y8OU8vDFMs0AdnW5oI1oWfqubJ2PMNIauLNPYvj8tEO-" },
    },
}

local function sendHello(webhook)
    if string.sub(webhook.Url, 1, 8) ~= "https://" then
        warn("Drey Finder prueba: configura el webhook " .. webhook.Name)
        return
    end

    local payload = {
        username = CONFIG.WebhookName,
        avatar_url = CONFIG.WebhookAvatar,
        embeds = {{
            title = "🔥 Rare Pet Found",
            description = "hola",
            color = 0xFFC850,
            footer = { text = CONFIG.FooterText },
        }},
    }

    local ok, response = pcall(function()
        return request({
            Url = webhook.Url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
    end)

    if not ok then
        warn("Drey Finder prueba: " .. webhook.Name .. " falló: " .. tostring(response))
    elseif type(response) == "table" and response.StatusCode and response.StatusCode >= 400 then
        warn("Drey Finder prueba: " .. webhook.Name .. " respondió HTTP " .. tostring(response.StatusCode))
    else
        print("Drey Finder prueba: mensaje enviado a " .. webhook.Name)
    end
end

for _, webhook in ipairs(CONFIG.Webhooks) do
    sendHello(webhook)
    task.wait(1)
end

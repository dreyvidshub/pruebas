tbl2.startNewTeleguiado = function()
	local newTGRuntime = tbl2.newTGRuntime
	if newTGRuntime.running then
		return false
	end

	if tick() < (newTGRuntime.cooldownUntil or 0) then
		return false
	end

	if not tbl4.enabled then
		return false
	end

	if not tbl2.canLeaveForSteal() then
		tbl4.waitingForDay = true
		tbl2.updateToggle()
		return false
	end

	tbl4.mode = "TELEGUIADO"
	tbl4.waitingForDay = false
	tbl4.targetEgg = nil
	tbl4.isMoving = false
	tbl4.isStealing = false
	tbl4.isProtecting = false
	tbl4.isDelivering = false
	tbl4.carrying = false
	tbl4.carryLocked = false
	tbl4.heldEggUid = nil
	newTGRuntime.running = true
	newTGRuntime.cleanup = nil
	tbl2.updateToggle()

	task.spawn(function()
		local ok, result = xpcall(function()
			local Players2 = game:GetService("Players")
			local ReplicatedStorage2 = game:GetService("ReplicatedStorage")
			local TweenService2 = game:GetService("TweenService")
			local RunService2 = game:GetService("RunService")
			local localPlayer2 = Players2.LocalPlayer
			local v16 = tbl4
			local newTGRuntime2 = tbl2.newTGRuntime
			local EggState = require(ReplicatedStorage2.Client.EggState)
			local RagdollJoints = require(ReplicatedStorage2.Shared.Modules.RagdollJoints)
			local Mutations2 = require(ReplicatedStorage2.Shared.Modules.Mutations)
			local Assets2 = require(ReplicatedStorage2.Data.Assets)
			local AreaEggSlotIdentity = require(ReplicatedStorage2.Shared.Util.AreaEggSlotIdentity)
			local areas = workspace.World.Areas
			local guardAreas2 = areas:WaitForChild("GuardAreas")
			local ground = areas:WaitForChild("Ground")
			local n13 = 800
			local character = localPlayer2.Character or localPlayer2.CharacterAdded:Wait()
			local humanoidRootPart2 = character:WaitForChild("HumanoidRootPart")

			-- ============================
			-- DESYNC (para mantener camara y evitar ragdoll)
			-- ============================
			local desyncOriginal, desyncOriginalState, desyncFake
			local humanoid2 = character:WaitForChild("Humanoid")
			desyncOriginal = humanoid2
			desyncOriginalState = {
				Archivable = humanoid2.Archivable,
				BreakJointsOnDeath = humanoid2.BreakJointsOnDeath,
				PlatformStand = humanoid2.PlatformStand,
				AutoRotate = humanoid2.AutoRotate,
				Sit = humanoid2.Sit,
				WalkSpeed = humanoid2.WalkSpeed,
				HipHeight = humanoid2.HipHeight,
				Health = humanoid2.Health,
			}

			humanoid2.Archivable = true
			desyncFake = humanoid2:Clone()
			desyncFake.Name = "Humanoid"
			desyncFake.BreakJointsOnDeath = false
			desyncFake:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			desyncFake:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
			desyncFake:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			pcall(function()
				desyncFake:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
			end)
			desyncFake.Health = desyncFake.MaxHealth
			pcall(function()
				desyncFake.RequiresNeck = false
			end)

			humanoid2.Parent = nil
			desyncFake.Parent = character
			desyncFake.PlatformStand = false
			desyncFake.Sit = false
			desyncFake.AutoRotate = true

			if workspace.CurrentCamera then
				workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
				workspace.CurrentCamera.CameraSubject = desyncFake
			end

			local flagRestored = false

			local function restoreDesync()
				if flagRestored then
					return
				end
				flagRestored = true

				if desyncFake then
					pcall(function()
						desyncFake:Destroy()
					end)
				end

				if desyncOriginal and desyncOriginal.Parent ~= character then
					desyncOriginal.Parent = character
				end

				if desyncOriginal then
					pcall(function()
						desyncOriginal.Archivable = desyncOriginalState.Archivable
						desyncOriginal.BreakJointsOnDeath = desyncOriginalState.BreakJointsOnDeath
						desyncOriginal.WalkSpeed = desyncOriginalState.WalkSpeed or desyncOriginal.WalkSpeed
						desyncOriginal.HipHeight = desyncOriginalState.HipHeight or desyncOriginal.HipHeight
						desyncOriginal.PlatformStand = false
						desyncOriginal.AutoRotate = true
						desyncOriginal.Sit = false
						desyncOriginal.Health = math.min(desyncOriginalState.Health, desyncOriginal.MaxHealth)
					end)

					pcall(function()
						desyncOriginal:ChangeState(Enum.HumanoidStateType.GettingUp)
					end)
				end

				if humanoidRootPart2 and humanoidRootPart2.Parent then
					humanoidRootPart2.AssemblyLinearVelocity = Vector3.zero
					humanoidRootPart2.AssemblyAngularVelocity = Vector3.zero
				end

				if workspace.CurrentCamera and desyncOriginal then
					workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
					workspace.CurrentCamera.CameraSubject = desyncOriginal
				end
			end

			newTGRuntime2.restoreDesync = restoreDesync

			-- ============================
			-- HELPERS
			-- ============================
			local function walk(arg, arg2)
				if not arg or not arg2 then
					return nil
				end
				local children = arg:GetChildren()
				while #children > 0 do
					local n14 = #children
					local v28 = children[n14]
					children[n14] = nil
					for _, child in ipairs(v28:GetChildren()) do
						children[#children + 1] = child
					end
					if arg2(v28) ~= true then
						continue
					end
					return v28
				end
				return nil
			end

			local function getAreaCenter(arg)
				if not arg then
					return nil
				end
				if arg:IsA("Model") then
					return arg:GetPivot().Position
				end
				if arg:IsA("BasePart") then
					return arg.Position
				end
				local basePart = arg:FindFirstChildWhichIsA("BasePart", true)
				return basePart and basePart.Position or nil
			end

			local function isPositionInsideArea(arg, arg2)
				if not arg2 then
					return false
				end
				local boundingBox, size
				if arg2:IsA("Model") then
					boundingBox, size = arg2:GetBoundingBox()
				else
					if not arg2:IsA("BasePart") then
						return false
					end
					boundingBox = arg2.CFrame
					size = arg2.Size
				end
				local v28 = boundingBox:PointToObjectSpace(arg)
				local n14 = size.X / 2
				local flag4 = math.abs(v28.X) <= n14
				local flag5
				if flag4 then
					local n15 = size.Z / 2
					flag5 = math.abs(v28.Z) <= n15
				else
					flag5 = flag4
				end
				return flag5 and math.abs(v28.Y) <= size.Y / 2 + 100
			end

			local function getAreaId(arg)
				if not arg then
					return nil
				end
				local areaId = arg.AreaId or arg.AreaName or arg.Area or arg.World or arg.Biome
				if type(areaId) == "string" and guardAreas2:FindFirstChild(areaId) then
					return areaId
				end
				local position = arg.Position
				if typeof(position) ~= "Vector3" and arg.BottomCFrame then
					position = arg.BottomCFrame.Position
				end
				if typeof(position) ~= "Vector3" then
					return nil
				end
				local v28 = nil
				local name = nil
				for _, child in ipairs(guardAreas2:GetChildren()) do
					if isPositionInsideArea(position, child) then
						return child.Name
					end
					local v29 = getAreaCenter(child)
					if v29 then
						local magnitude = (Vector3.new(v29.X, 0, v29.Z) - Vector3.new(position.X, 0, position.Z)).Magnitude
						if not v28 or magnitude < v28 then
							name = child.Name
							v28 = magnitude
						end
					end
				end
				return name
			end

			-- ============================
			-- TWEEN / MOVIMIENTO
			-- ============================
			local activeTween = nil

			local function settle()
				humanoidRootPart2.AssemblyLinearVelocity = Vector3.zero
				humanoidRootPart2.AssemblyAngularVelocity = Vector3.zero
				RunService2.Heartbeat:Wait()
				RunService2.Heartbeat:Wait()
			end

			local function moveTo(pos, speed)
				if typeof(pos) ~= "Vector3" or not humanoidRootPart2 or not humanoidRootPart2.Parent then
					return false
				end
				local n14 = tonumber(speed) or 500
				humanoidRootPart2.AssemblyLinearVelocity = Vector3.zero
				humanoidRootPart2.AssemblyAngularVelocity = Vector3.zero
				local vector = Vector3.new(pos.X - humanoidRootPart2.Position.X, 0, pos.Z - humanoidRootPart2.Position.Z)
				local cframe = CFrame.new(pos)
				if vector.Magnitude > 0.01 then
					cframe = CFrame.lookAt(pos, pos + vector.Unit)
				end
				local tween = TweenService2:Create(
					humanoidRootPart2,
					TweenInfo.new(math.max((pos - humanoidRootPart2.Position).Magnitude / n14, 0.01), Enum.EasingStyle.Linear),
					{ CFrame = cframe }
				)
				activeTween = tween
				tween:Play()
				local completed = tween.Completed:Wait()
				if activeTween == tween then
					activeTween = nil
				end
				if humanoidRootPart2 and humanoidRootPart2.Parent then
					humanoidRootPart2.AssemblyLinearVelocity = Vector3.zero
					humanoidRootPart2.AssemblyAngularVelocity = Vector3.zero
				end
				return completed == Enum.PlaybackState.Completed
			end

			-- ============================
			-- SNAPSHOT / HUEVOS
			-- ============================
			local function snapshot()
				local ok2, result = pcall(EggState.SyncFieldEggs)
				if ok2 and result and result.Records then
					return result
				end
				local ok3, result2 = pcall(function()
					return tbl.AskFieldEggSnapshot:InvokeServer()
				end)
				if ok3 and result2 and result2.Records then
					return result2
				end
				return nil
			end

			local function earningsOf(record)
				local directory = Assets2.Directory[record.AssetCategory]
				if not directory then
					return 0
				end
				local scale = tonumber(record.AssetScale) or 1
				local scaleMult
				if scale <= 5 then
					scaleMult = scale ^ 1.85
				else
					scaleMult = (scale / 5) ^ 1.2 * 19.637875755794113
				end
				local mutMult = 1
				if record.Mutations and #record.Mutations > 0 then
					local ok2, result = pcall(Mutations2.EarningsFor, record.Mutations)
					if ok2 then
						mutMult = tonumber(result) or 1
					end
				end
				return (tonumber(directory.EarningRate) or 0) * scaleMult * mutMult
			end

			local function findRecordByUid(uid)
				if not uid then
					return nil
				end
				local snap = snapshot()
				if not snap then
					return nil
				end
				for _, record in ipairs(snap.Records) do
					if record.Uid and tostring(record.Uid) == tostring(uid) and (record.State == "Slot" or record.State == "Dropped") then
						return record
					end
				end
				return nil
			end

			local function pickBestRecord(skipUid)
				local snap = snapshot()
				if not snap then
					return nil
				end

				local selectedEgg = tbl2.getActiveTargetEgg and tbl2.getActiveTargetEgg() or nil
				if selectedEgg and selectedEgg.Uid then
					for _, record in ipairs(snap.Records) do
						if record.Uid and tostring(record.Uid) == tostring(selectedEgg.Uid) and record.Uid ~= skipUid and record.BottomCFrame and (record.State == "Slot" or record.State == "Dropped") then
							return record
						end
					end
				end

				local bestVal = -math.huge
				local bestRecord = nil
				for _, record in ipairs(snap.Records) do
					if record.Uid and record.Uid ~= skipUid and record.BottomCFrame and (record.State == "Slot" or record.State == "Dropped") then
						local flag4 = true
						if tbl2.getEggData and tbl2.eggMatchesRarityFilter then
							local ok2, data2 = pcall(tbl2.getEggData, record)
							if ok2 and data2 then
								flag4 = tbl2.eggMatchesRarityFilter(data2)
							end
						end
						if flag4 then
							local val = earningsOf(record)
							if val > bestVal then
								bestVal = val
								bestRecord = record
							end
						end
					end
				end
				return bestRecord
			end

			local function carryEgg(record)
				if not record then
					return false
				end
				local nestId = AreaEggSlotIdentity.LooksLikeFirstAreaUid(record.Uid) and record.NestId
				local slotKey = nil
				if nestId then
					slotKey = AreaEggSlotIdentity.SlotKey(record.AreaId, record.NestId)
				end
				local ok2, result = pcall(EggState.CarryFieldEgg, record.Uid, slotKey)
				if ok2 and result then
					return true
				end
				local ok3, result2 = pcall(function()
					return tbl.AskFieldEggCarry:InvokeServer({ Uid = record.Uid })
				end)
				return ok3 and result2 == true
			end

			local function dropEgg()
				pcall(function()
					tbl.AskFieldEggDrop:InvokeServer({ Reason = "PlayerRequest" })
				end)
			end

			-- ============================
			-- ESTADOS
			-- ============================
			local state = "idle"
			local targetRecord = nil
			local targetUid = nil
			local firstCarryRecord = nil
			local firstCarryUid = nil

			-- ============================
			-- FASE 1: IR AL HUEVO CARO Y AGARRARLO
			-- FASE 2: TRAERLO AL START AREA
			-- FASE 3: SOLTARLO Y ESPERAR
			-- FASE 4: REAGARRARLO
			-- FASE 5: LLEVARLO AL GROUND Y ENTREGAR
			-- ============================

			local function endCycle(success)
				newTGRuntime2.running = false
				newTGRuntime2.cleanup = nil
				v16.lastRefresh = 0

				pcall(restoreDesync)

				if v16.enabled and v16.loopEnabled then
					newTGRuntime2.cooldownUntil = tick() + 0.15
					task.delay(0.16, function()
						if v16.enabled and v16.loopEnabled then
							tbl2.startNewTeleguiado()
						end
					end)
				else
					v16.enabled = false
					v16.runLoop = false
					v16.waitingForDay = false
					if tbl2.updateToggle then
						tbl2.updateToggle()
					end
				end
			end

			local function startPhase1()
				if not newTGRuntime2.running then
					return
				end
				state = "movingToEgg"

				local record = pickBestRecord(nil)
				if not record then
					state = "idle"
					endCycle(false)
					return
				end

				targetRecord = record
				targetUid = record.Uid

				task.spawn(function()
					local run = true
					while run and newTGRuntime2.running and state == "movingToEgg" do
						local rec = findRecordByUid(targetUid) or targetRecord
						if not rec or not rec.BottomCFrame then
							break
						end
						local pos = rec.BottomCFrame.Position + Vector3.new(0, 3, 0)
						local arrived = moveTo(pos, n13)
						if not newTGRuntime2.running or state ~= "movingToEgg" then
							return
						end
						if arrived then
							-- spamear carry hasta agarrarlo
							for i = 1, 40 do
								if not newTGRuntime2.running or state ~= "movingToEgg" then
									return
								end
								if carryEgg(rec) then
									break
								end
								task.wait(0.04)
							end
							-- verificar si esta cargando
							task.wait(0.2)
							local current = findRecordByUid(targetUid)
							if current and current.CarrierUserId == localPlayer2.UserId then
								firstCarryRecord = current
								firstCarryUid = current.Uid
								run = false
								state = "movingToStart"
								task.spawn(startPhase2)
								return
							end
							break
						end
					end
					if state == "movingToEgg" then
						state = "idle"
						endCycle(false)
					end
				end)
			end

			local function startPhase2()
				if not newTGRuntime2.running then
					return
				end

				local startPos = tbl3.START_AREA_POSITION
				-- Volar con el huevo hacia el StartArea
				local run = true
				while run and newTGRuntime2.running and state == "movingToStart" do
					local arrived = moveTo(startPos, n13)
					if not newTGRuntime2.running or state ~= "movingToStart" then
						return
					end
					if arrived then
						run = false
						state = "droppingAtStart"
						task.spawn(startPhase3)
						return
					end
					break
				end
				if state == "movingToStart" then
					state = "idle"
					endCycle(false)
				end
			end

			local function startPhase3()
				if not newTGRuntime2.running then
					return
				end

				settle()
				-- Soltar el huevo
				dropEgg()
				task.wait(0.35)
				dropEgg()
				task.wait(0.35)

				-- Esperar entre 0.5 y 1s
				local waitTime = 0.5 + math.random() * 0.5
				local t0 = tick()
				while tick() - t0 < waitTime do
					if not newTGRuntime2.running then
						return
					end
					task.wait(0.05)
				end

				state = "pickingAgain"
				task.spawn(startPhase4)
			end

			local function startPhase4()
				if not newTGRuntime2.running then
					return
				end

				local rec = findRecordByUid(firstCarryUid) or firstCarryRecord
				if not rec then
					-- buscar el mas cercano al StartArea
					local snap = snapshot()
					if snap then
						local closest = nil
						local bestDist = math.huge
						for _, record in ipairs(snap.Records) do
							if record.Uid and record.BottomCFrame and (record.State == "Slot" or record.State == "Dropped") then
								local dist = (record.BottomCFrame.Position - tbl3.START_AREA_POSITION).Magnitude
								if dist < bestDist then
									bestDist = dist
									closest = record
								end
							end
						end
						rec = closest
					end
				end

				if not rec or not rec.BottomCFrame then
					state = "idle"
					endCycle(false)
					return
				end

				local run = true
				while run and newTGRuntime2.running and state == "pickingAgain" do
					local rec2 = findRecordByUid(rec.Uid) or rec
					local pos = rec2.BottomCFrame.Position + Vector3.new(0, 3, 0)
					local arrived = moveTo(pos, n13)
					if not newTGRuntime2.running or state ~= "pickingAgain" then
						return
					end
					if arrived then
						for i = 1, 50 do
							if not newTGRuntime2.running or state ~= "pickingAgain" then
								return
							end
							if carryEgg(rec2) then
								break
							end
							task.wait(0.04)
						end
						task.wait(0.2)
						local current = findRecordByUid(rec2.Uid)
						if current and current.CarrierUserId == localPlayer2.UserId then
							run = false
							state = "delivering"
							task.spawn(startPhase5)
							return
						end
						break
					end
				end
				if state == "pickingAgain" then
					state = "idle"
					endCycle(false)
				end
			end

			local function startPhase5()
				if not newTGRuntime2.running then
					return
				end

				local groundPos = tbl2.getGroundPosition()
				if not groundPos then
					state = "idle"
					endCycle(false)
					return
				end

				local arrived = moveTo(groundPos, n13)
				if not newTGRuntime2.running or state ~= "delivering" then
					return
				end

				settle()
				dropEgg()
				task.wait(0.3)
				dropEgg()

				state = "done"
				pcall(restoreDesync)
				endCycle(true)
			end

			-- ============================
			-- CLEANUP
			-- ============================
			newTGRuntime2.cleanup = function()
				state = "cancelled"
				if activeTween then
					pcall(function()
						activeTween:Cancel()
					end)
					activeTween = nil
				end
				pcall(restoreDesync)
				newTGRuntime2.running = false
			end

			-- ============================
			-- INICIAR
			-- ============================
			task.spawn(startPhase1)
		end, function(arg)
			return debug.traceback(tostring(arg), 2)
		end)

		if not ok then
			newTGRuntime.running = false
			local cleanup = newTGRuntime.cleanup
			newTGRuntime.cleanup = nil
			if cleanup then
				pcall(cleanup)
			end
			if newTGRuntime.restoreDesync then
				pcall(newTGRuntime.restoreDesync)
			end
			tbl4.enabled = false
			tbl4.runLoop = false
			tbl4.waitingForDay = false
			tbl2.updateToggle()
			warn("[NEW TELEGUIADO ERROR]", result)
		end
	end)

	return true
end


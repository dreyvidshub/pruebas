local function findPath(root, path)
    local current = root
    -- Acepta rutas copiadas tanto con puntos como con barras.
    for part in string.gmatch(path, "[^%./]+") do
        if not current then return nil end
        current = current:FindFirstChild(part)
    end
    return current
end

local SnapshotRemote
local function findSnapshotRemote()
    if SnapshotRemote and SnapshotRemote.Parent then
        return SnapshotRemote
    end

    -- Primero prueba la ruta conocida y luego busca el nombre en toda la jerarquía.
    SnapshotRemote = findPath(ReplicatedStorage, "Packages.Networking.RF/EggWorld/AskFieldEggSnapshot")
    if SnapshotRemote and SnapshotRemote:IsA("RemoteFunction") then
        return SnapshotRemote
    end

    local candidates = {}
    for _, instance in ipairs(ReplicatedStorage:GetDescendants()) do
        if instance:IsA("RemoteFunction") then
            local normalizedName = string.lower(instance.Name):gsub("[^%w]", "")
            if normalizedName == "askfieldeggsnapshot"
                or (string.find(normalizedName, "egg", 1, true)
                    and string.find(normalizedName, "snapshot", 1, true)) then
                SnapshotRemote = instance
                return SnapshotRemote
            end
            if #candidates < 8 and (string.find(normalizedName, "egg", 1, true)
                or string.find(normalizedName, "snapshot", 1, true)) then
                table.insert(candidates, instance:GetFullName())
            end
        end
    end

    local detail = #candidates > 0 and (" Remotos parecidos: " .. table.concat(candidates, "; ")) or " No hay RemoteFunctions con 'egg' o 'snapshot' visibles."
    return nil, "No se encontró AskFieldEggSnapshot en ReplicatedStorage." .. detail
end

local Catalog = {}
pcall(function()
    local data = ReplicatedStorage:FindFirstChild("Data")
    local assets = data and data:FindFirstChild("Assets")
    if assets then
        local module = require(assets)
        if type(module) == "table" and type(module.Directory) == "table" then
            Catalog = module.Directory
        end
    end
end)

local function getHttpRequest()
    return request or http_request or (syn and syn.request)
end

local function getEggInfo(assetCategory, record)
    local entry = Catalog[tostring(assetCategory)]
    if type(entry) ~= "table" then return nil end

    local earning = tonumber(entry.EarningRate) or 0
    local scale = tonumber(record.AssetScale) or 1
    local mutations = record.Mutations
    local mutationCount = type(mutations) == "table" and #mutations or 0
    local mutationBonus = 1 + mutationCount * 0.25

    return {
        name = entry.DisplayName or entry._id or tostring(assetCategory),
        earning = math.floor(earning * scale * mutationBonus),
    }
end

local function formatMoney(value)
    if value >= 1e12 then return string.format("%.2fT", value / 1e12) end
    if value >= 1e9 then return string.format("%.2fB", value / 1e9) end
    if value >= 1e6 then return string.format("%.2fM", value / 1e6) end
    if value >= 1e3 then return string.format("%.2fK", value / 1e3) end
    return tostring(math.floor(value))
end

local function fingerprintEgg(egg)
    return table.concat({
        string.lower(egg.name),
        tostring(egg.earning),
        string.format("%.4f", egg.size),
    }, "|")
end

local function getEligibleEggs()
    local remote, remoteError = findSnapshotRemote()
    if not remote then
        return nil, remoteError
    end

    local ok, snapshot = pcall(function()
        return remote:InvokeServer()
    end)
    if not ok or type(snapshot) ~= "table" then
        return nil, "No se pudo leer el snapshot del servidor."
    end

    local records = snapshot.Records or snapshot
    if type(records) ~= "table" then return nil end

    local eggs = {}
    local observedFingerprints = {}
    for recordKey, record in pairs(records) do
        if type(record) == "table" and record.AssetCategory then
            local info = getEggInfo(record.AssetCategory, record)
            if info and info.earning >= CONFIG.MinimumEarning then
                local identity = record.Id or record.ID or record.RecordId
                    or record.Guid or record.GUID or record.UUID or record.Uid
                    or record.InstanceId or record.InstanceID or recordKey
                if identity == nil then
                    -- Fallback estable para snapshots sin UUID visible.
                    identity = table.concat({
                        tostring(record.OwnerUserId or record.OwnerId or record.Owner or ""),
                        tostring(record.Plot or record.PlotId or ""),
                        tostring(record.Slot or record.SlotId or record.Index or ""),
                        tostring(record.AssetCategory),
                        tostring(record.AssetScale or 1),
                        tostring(record.State),
                    }, "|")
                end
                local egg = {
                    id = tostring(identity),
                    name = info.name,
                    earning = info.earning,
                    size = tonumber(record.AssetScale) or 1,
                }
                observedFingerprints[fingerprintEgg(egg)] = true
                if record.State == "Slot" then
                    table.insert(eggs, egg)
                end
            end
        end
    end

    table.sort(eggs, function(a, b)
        if a.earning == b.earning then
            return a.id < b.id
        end
        return a.earning > b.earning
    end)
    return eggs, nil, observedFingerprints
end

local function sendToDiscord(best, webhook, includeServerInfo)
    local httpRequest = getHttpRequest()
    if type(httpRequest) ~= "function" then
        return false, "Volt no expone request/http_request/syn.request."
    end

    local thumbnailUrl = IMAGE_BY_NAME[best.name]
    local description = string.format("```%s | $%s/s```", best.name, formatMoney(best.earning))
    local fields = nil
    if includeServerInfo then
        local serverId = tostring(game.JobId or "")
        if serverId == "" then serverId = "No disponible" end
        local placeId = tostring(game.PlaceId or "")
        local serverUrl = "https://www.roblox.com/games/start?placeId="
            .. placeId .. "&gameInstanceId=" .. HttpService:UrlEncode(serverId)
        fields = {
            { name = "📱 ID del servidor (móvil)", value = "`" .. serverId .. "`", inline = false },
            { name = "💻 ID del servidor (PC)", value = "```" .. serverId .. "```", inline = false },
            { name = "Entrar al servidor", value = "[Abrir servidor](" .. serverUrl .. ")", inline = false },
        }
    end

    local payload = {
        username = CONFIG.WebhookName,
        avatar_url = CONFIG.WebhookAvatar,
        embeds = {{
            title = "🔥 Rare Pet Found",
            description = description,
            thumbnail = thumbnailUrl and { url = thumbnailUrl } or nil,
            fields = fields,
            color = 0xFFC850,
            footer = { text = CONFIG.FooterText },
        }},
    }

    local ok, response = pcall(function()
        return httpRequest({
            Url = webhook,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
    end)

    if not ok then return false, tostring(response) end
    if type(response) == "table" and response.StatusCode and response.StatusCode >= 400 then
        return false, "Discord HTTP " .. tostring(response.StatusCode)
    end
    return true
end

local lastAnnouncedTopKey = nil
local pendingTop = nil
local pendingTopKey = nil
local pendingDeliveries = nil
local sentEggFingerprints = {}
local FINGERPRINT_ABSENCE_SECONDS = 180 -- 3 minutos
local emptyScans = 0
local lastAttemptAt = -30
local lastScanError = nil
local lastSendError = nil
local MIN_SECONDS_BETWEEN_MESSAGES = 2

while true do
    local eggs, scanError, observedFingerprints = getEligibleEggs()
    if scanError then
        if scanError ~= lastScanError then
            warn("Drey Finder: " .. scanError)
            lastScanError = scanError
        end
    else
        lastScanError = nil
        if eggs then
            local now = os.clock()
            for fingerprint in pairs(observedFingerprints or {}) do
                local sentState = sentEggFingerprints[fingerprint]
                if sentState then
                    sentState.lastSeenAt = now
                end
            end

            -- No borra el recuerdo por desapariciones breves al cargar/soltar.
            -- Si no vuelve a verse durante 3 minutos, se considera otro spawn.
            for fingerprint, sentState in pairs(sentEggFingerprints) do
                if not presentFingerprints[fingerprint]
                    and now - sentState.lastSeenAt >= FINGERPRINT_ABSENCE_SECONDS then
                    sentEggFingerprints[fingerprint] = nil
                end
            end

            local top = eggs[1]
            if top then
                emptyScans = 0
                -- Usa la identidad visible del huevo, no el ID del registro:
                -- al soltarlo y volverlo a tomar, el juego puede crear otro ID.
                local key = fingerprintEgg(top)
                if sentEggFingerprints[key] then
                    pendingTop = nil
                    pendingTopKey = nil
                    pendingDeliveries = nil
                    lastAnnouncedTopKey = key
                elseif key ~= lastAnnouncedTopKey then
                    if key ~= pendingTopKey then
                        -- Un aviso normal conserva el filtro original; el webhook
                        -- adicional recibe también los datos del servidor desde 100 M/s.
                        pendingTop = top
                        pendingTopKey = key
                        pendingDeliveries = {{
                            url = top.earning >= CONFIG.HighTierMinimum
                                and CONFIG.HighWebhook or CONFIG.LowWebhook,
                            includeServerInfo = false,
                        }}
                    end
                else
                    pendingTop = nil
                    pendingTopKey = nil
                    pendingDeliveries = nil
                end
            else
                emptyScans += 1
                if emptyScans >= 3 then
                    lastAnnouncedTopKey = nil
                    pendingTop = nil
                    pendingTopKey = nil
                    pendingDeliveries = nil
                end
            end

            if pendingTop and pendingDeliveries and #pendingDeliveries > 0
                and now - lastAttemptAt >= MIN_SECONDS_BETWEEN_MESSAGES then
                local delivery = table.remove(pendingDeliveries, 1)
                lastAttemptAt = now
                local sent, sendError = sendToDiscord(pendingTop, delivery.url, delivery.includeServerInfo)
                if sent then
                    lastSendError = nil
                    if #pendingDeliveries == 0 then
                        lastAnnouncedTopKey = pendingTopKey
                        sentEggFingerprints[pendingTopKey] = { lastSeenAt = now }
                        pendingTop = nil
                        pendingTopKey = nil
                        pendingDeliveries = nil
                    end
                else
                    if sendError ~= lastSendError then
                        warn("Drey Finder: " .. tostring(sendError))
                        lastSendError = sendError
                    end
                    table.insert(pendingDeliveries, 1, delivery)
                end
            end
        end
    end

    task.wait(CONFIG.ScanInterval)
end


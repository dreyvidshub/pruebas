    if Selection.Highlight then
        Selection.Highlight.FillColor = Color3.fromHSV(hue, 1, 1)
        Selection.Highlight.OutlineColor = Color3.fromHSV((hue + 0.5) % 1, 1, 1)
    end
end)

local function updatePanelPosition()
    Panel.Position = UDim2.new(
        MiniSquare.Position.X.Scale,
        MiniSquare.Position.X.Offset - PANEL_W - 8,
        MiniSquare.Position.Y.Scale,
        MiniSquare.Position.Y.Offset
    )
end

local function openPanel()
    if Panel.Visible then return end
    updatePanelPosition()
    Panel.Visible = true
    Panel.Size = UDim2.fromOffset(0, 0)
    TweenService:Create(Panel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(PANEL_W, PANEL_H),
    }):Play()
end

local function closePanel()
    if not Panel.Visible then return end
    TweenService:Create(Panel, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.fromOffset(0, 0),
    }):Play()
    task.delay(0.25, function()
        Panel.Visible = false
        Panel.Size = UDim2.fromOffset(PANEL_W, PANEL_H)
    end)
end

local function togglePanel()
    if Panel.Visible then closePanel() else openPanel() end
end

MiniBtn.MouseButton1Click:Connect(function()
    if isDragging then return end
    togglePanel()
end)

MinBtn.MouseButton1Click:Connect(function()
    closePanel()
end)

local function ClearRows()
    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
end

local function CreateRow(data, index)
    local isSelected = (Selection.Uid ~= nil and tostring(Selection.Uid) == tostring(data.uid))

    local r = Instance.new("TextButton")
    r.Size = UDim2.new(1, 0, 0, 46)
    r.BackgroundColor3 = isSelected and C.BgRowHover or C.BgRow
    r.BorderSizePixel = 0
    r.Text = ""
    r.AutoButtonColor = false
    r.LayoutOrder = index
    r.Parent = List
    corner(r, 7)

    local rStroke = stroke(r, isSelected and C.StrokeHi or C.Stroke,
                          isSelected and 1.5 or 1,
                          isSelected and 0 or 0.5)

    local iconBg = Instance.new("Frame")
    iconBg.Size = UDim2.fromOffset(32, 32)
    iconBg.Position = UDim2.new(0, 7, 0.5, -16)
    iconBg.BackgroundColor3 = C.BgInner
    iconBg.BorderSizePixel = 0
    iconBg.Parent = r
    corner(iconBg, 5)

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(1, -4, 1, -4)
    icon.Position = UDim2.new(0, 2, 0, 2)
    icon.BackgroundTransparency = 1
    icon.Image = data.icon or ""
    icon.ScaleType = Enum.ScaleType.Fit
    icon.Parent = iconBg

    local nm = Instance.new("TextLabel")
    nm.Size = UDim2.new(1, -140, 0, 14)
    nm.Position = UDim2.new(0, 46, 0, 6)
    nm.BackgroundTransparency = 1
    nm.Font = Enum.Font.GothamBold
    nm.Text = data.name
    nm.TextSize = 10
    nm.TextColor3 = C.White
    nm.TextXAlignment = Enum.TextXAlignment.Left
    nm.TextTruncate = Enum.TextTruncate.AtEnd
    nm.Parent = r

    local rr = Instance.new("TextLabel")
    rr.Size = UDim2.new(1, -140, 0, 12)
    rr.Position = UDim2.new(0, 46, 0, 21)
    rr.BackgroundTransparency = 1
    rr.Font = Enum.Font.Gotham
    rr.Text = data.rarity
    rr.TextSize = 8
    rr.TextColor3 = data.rarityColor
    rr.TextXAlignment = Enum.TextXAlignment.Left
    rr.Parent = r

    local vl = Instance.new("TextLabel")
    vl.Size = UDim2.new(0, 90, 1, 0)
    vl.Position = UDim2.new(1, -94, 0, 0)
    vl.BackgroundTransparency = 1
    vl.Font = Enum.Font.GothamBold
    vl.Text = "$" .. FormatMoney(data.value) .. "/s"
    vl.TextSize = 11
    vl.TextColor3 = C.Green
    vl.TextXAlignment = Enum.TextXAlignment.Right
    vl.Parent = r

    r.MouseEnter:Connect(function()
        if Selection.Uid ~= data.uid then
            r.BackgroundColor3 = C.BgRowHover
        end
    end)
    r.MouseLeave:Connect(function()
        if Selection.Uid ~= data.uid then
            r.BackgroundColor3 = C.BgRow
        end
    end)

    r.MouseButton1Click:Connect(function()
        if Selection.Uid ~= nil and tostring(Selection.Uid) == tostring(data.uid) then
            cleanSelection()
            StatusLbl.Text = "selección quitada"
        else
            createSelection(data.uid, data.name)
        end
        pcall(updateList)
    end)
end

local function updateList()
    local list = getList()
    StatusLbl.Text = #list .. " huevos"

    if #list > 0 and list[1].icon ~= "" then
        MiniIcon.Image = list[1].icon
        MiniIcon.Visible = true
        MiniFallback.Visible = false
    else
        MiniIcon.Visible = false
        MiniFallback.Visible = true
    end

    ClearRows()
    for i = 1, math.min(#list, 50) do
        CreateRow(list[i], i)
    end
end

task.spawn(function()
    while true do
        pcall(updateList)
        task.wait(3)
    end
end)


local function disableUGI()
    if type(getconnections) ~= "function" then return end
    for _, signal in ipairs({RunService.Heartbeat, RunService.PreSimulation, RunService.PostSimulation}) do
        local ok, conns = pcall(getconnections, signal)
        if not ok or type(conns) ~= "table" then continue end
        for _, c in ipairs(conns) do
            local ok2, fn = pcall(function() return c.Function end)
            if not ok2 or type(fn) ~= "function" then continue end
            local ok3, info = pcall(debug.info, fn, "s")
            if not ok3 then continue end
            if string.find(tostring(info), "UGI", 1, true) then
                local ok4, enabled = pcall(function() return c.Enabled end)
                if not ok4 or enabled ~= false then
                    if pcall(function() c:Disable() end) then
                        table.insert(shield.Disabled, c)
                    end
                end
            end
        end
    end
end

local function enableUGI()
    for _, c in ipairs(shield.Disabled) do
        pcall(function() c:Enable() end)
    end
    table.clear(shield.Disabled)
end

local function clearLinks()
    for _, link in ipairs(shield.Links) do
        pcall(function() link:Disconnect() end)
    end
    table.clear(shield.Links)
end

local function undoSwap()
    clearLinks()
    local character = localPlayer.Character
    local original = shield.Original
    local clone = shield.Clone
    shield.Original = nil
    shield.Clone = nil
    if original and clone and character and original.Parent == nil and clone.Parent == character then
        original.Parent = character
        workspace.CurrentCamera.CameraSubject = original
        pcall(function() clone:Destroy() end)
        pcall(function()
            local ps = localPlayer:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            if pm then
                local controls = require(pm):GetControls()
                if type(controls) == "table" then controls.humanoid = original end
            end
        end)
        local anim = character:FindFirstChild("Animate")
        if anim and anim:IsA("LocalScript") then
            task.spawn(function()
                anim.Enabled = false
                task.wait()
                anim.Enabled = true
            end)
        end
    end
end

local function grounded(hum)
    if not hum then
        local char = localPlayer.Character
        hum = char and char:FindFirstChildOfClass("Humanoid")
    end
    if not hum or hum.Health <= 0 or hum.FloorMaterial == Enum.Material.Air then
        return false
    end
    local state = hum:GetState()
    return state == Enum.HumanoidStateType.Running
        or state == Enum.HumanoidStateType.RunningNoPhysics
        or state == Enum.HumanoidStateType.Landed
end

local function doSwap()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    if shield.Clone and shield.Clone.Parent == character then return end
    if not grounded(humanoid) then return end

    local clone = humanoid:Clone()
    humanoid.Parent = nil
    clone.Parent = character
    workspace.CurrentCamera.CameraSubject = clone

    pcall(function()
        local ps = localPlayer:FindFirstChild("PlayerScripts")
        local pm = ps and ps:FindFirstChild("PlayerModule")
        if pm then
            local controls = require(pm):GetControls()
            if type(controls) == "table" then controls.humanoid = clone end
        end
    end)

    local anim = character:FindFirstChild("Animate")
    if anim and anim:IsA("LocalScript") then
        task.spawn(function()
            anim.Enabled = false
            task.wait()
            anim.Enabled = true
        end)
    end

    shield.Original = humanoid
    shield.Clone = clone

    local animator1 = humanoid:FindFirstChildOfClass("Animator")
    local animator2 = clone:FindFirstChildOfClass("Animator")

    if animator1 and animator2 then
        table.insert(shield.Links, animator1.AnimationPlayed:Connect(function(track)
            local animation = track.Animation
            if not animation or clone.Parent == nil then return end
            local ok, newTrack = pcall(function()
                return animator2:LoadAnimation(animation)
            end)
            if not ok or not newTrack then return end
            pcall(function()
                newTrack.Priority = track.Priority
                newTrack.Looped = track.Looped
                newTrack:Play(0.05, math.max(track.WeightTarget, 0.01), track.Speed)
            end)
            local stopped
            stopped = track.Stopped:Connect(function()
                stopped:Disconnect()
                pcall(function() newTrack:Stop(0.1) end)
            end)
        end))
    end

    table.insert(shield.Links, clone.Died:Connect(function()
        clearLinks()
        local orig = shield.Original
        shield.Original = nil
        shield.Clone = nil
        local char = localPlayer.Character
        if char and orig and orig.Parent == nil then
            orig.Parent = char
            workspace.CurrentCamera.CameraSubject = orig
            pcall(function()
                local ps = localPlayer:FindFirstChild("PlayerScripts")
                local pm = ps and ps:FindFirstChild("PlayerModule")
                if pm then
                    local c = require(pm):GetControls()
                    if type(c) == "table" then c.humanoid = orig end
                end
            end)
        end
        pcall(function() clone:Destroy() end)
        if orig then orig.Health = 0 end
    end))
end

local function getRoot()
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if root and hum and hum.Health > 0 then return root, hum end
    return nil, nil
end

local function speedLoop()
    if not activo then return end
    local ragdollEnd = tonumber(localPlayer:GetAttribute("RagdollEndTime"))
    if ragdollEnd and ragdollEnd > workspace:GetServerTimeNow() then return end
    local root, hum = getRoot()
    if not root or not hum then return end
    if hum.Sit or hum.PlatformStand then return end
    local moveDir = hum.MoveDirection
    local flat = Vector3.new(moveDir.X, 0, moveDir.Z)
    if flat.Magnitude <= 0.001 then return end
    local target = flat.Unit * VEL
    local currentVel = root.AssemblyLinearVelocity
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(target.X, currentVel.Y, target.Z)
    end)
end


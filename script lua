-- =====================================================
-- CONFIG
-- =====================================================
local CONFIG = {
    Enabled       = false,
    Radius        = 30,       -- studs de distancia para comprar
    ScanInterval  = 0.5,      -- cada cuánto busca prompts
    BuyDelay      = 0.05,     -- delay entre disparos
    AutoKickAfter = true,     -- kick al comprar (por si querés desconectar)
    Keybind       = Enum.KeyCode.N,
}

-- =====================================================
-- UTILS
-- =====================================================
local function getPlayerRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getPrompts()
    local list = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local at = (obj.ActionText or ""):lower()
            if at:find("purchase") or at:find("buy") then
                local parent = obj.Parent
                local pos
                if parent and parent:IsA("Attachment") then
                    pos = parent.WorldPosition
                elseif parent and parent:IsA("BasePart") then
                    pos = parent.Position
                elseif parent and parent.Parent and parent.Parent:IsA("BasePart") then
                    pos = parent.Parent.Position
                end
                if pos then
                    table.insert(list, { prompt = obj, pos = pos, parent = parent })
                end
            end
        end
    end
    return list
end

local function getClosestPrompt(rootPos)
    local best, bestDist = nil, CONFIG.Radius
    for _, item in ipairs(getPrompts()) do
        local d = (item.pos - rootPos).Magnitude
        if d < bestDist then
            bestDist = d
            best = item
        end
    end
    return best, bestDist
end

-- =====================================================
-- COMPRA
-- =====================================================
local function tryBuy(promptData)
    if not promptData or not promptData.prompt or not promptData.prompt.Parent then
        return false
    end
    local prompt = promptData.prompt
    -- Bajar el hold para que dispare al instante
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 100
    end)
    -- Intentar disparar
    local ok = pcall(function()
        fireproximityprompt(prompt, 0)
    end)
    if not ok then
        -- Fallback: simular input
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.02)
            prompt:InputHoldEnd()
        end)
    end
    return true
end

-- =====================================================
-- LOOP PRINCIPAL
-- =====================================================
local lastScan = 0
local boughtCount = 0
local statusText = "Esperando..."

RunService.Heartbeat:Connect(function()
    if not CONFIG.Enabled then return end
    local now = tick()
    if now - lastScan < CONFIG.ScanInterval then return end
    lastScan = now

    local root = getPlayerRoot()
    if not root then
        statusText = "Sin personaje"
        return
    end

    local target, dist = getClosestPrompt(root.Position)
    if not target then
        statusText = "Nada cerca"
        return
    end

    statusText = string.format("Comprando: %s (%.1fm)", target.prompt.ActionText or "?", dist)
    if tryBuy(target) then
        boughtCount += 1
        task.wait(CONFIG.BuyDelay)
    end
end)


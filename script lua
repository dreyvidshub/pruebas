local activado = false

local function actualizarUI()
    if activado then
        TweenService:Create(Indicador, TweenInfo.new(0.2), { BackgroundColor3 = CONFIG.ColorActivo }):Play()
        TweenService:Create(TextoEstado, TweenInfo.new(0.2), { TextColor3 = CONFIG.ColorActivo, Text = "ACTIVO" }):Play()
        TweenService:Create(TextoBoton, TweenInfo.new(0.2), { Text = "DESACTIVAR DREYVID HUB" }):Play()
        TweenService:Create(SubTextoBoton, TweenInfo.new(0.2), { Text = "Sistema funcionando" }):Play()
        TweenService:Create(Toggle, TweenInfo.new(0.2), { BackgroundColor3 = CONFIG.ColorActivo }):Play()
        TweenService:Create(ToggleCircle, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.new(1, -23, 0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255) }):Play()
        TweenService:Create(TextoDesc, TweenInfo.new(0.2), { Text = "Hub activado y protegido" }):Play()
        TweenService:Create(BotonActivar, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(30, 50, 40) }):Play()
    else
        TweenService:Create(Indicador, TweenInfo.new(0.2), { BackgroundColor3 = CONFIG.ColorInactivo }):Play()
        TweenService:Create(TextoEstado, TweenInfo.new(0.2), { TextColor3 = CONFIG.ColorInactivo, Text = "INACTIVO" }):Play()
        TweenService:Create(TextoBoton, TweenInfo.new(0.2), { Text = "ACTIVAR DREYVID HUB" }):Play()
        TweenService:Create(SubTextoBoton, TweenInfo.new(0.2), { Text = "Presiona para activar" }):Play()
        TweenService:Create(Toggle, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(55, 60, 70) }):Play()
        TweenService:Create(ToggleCircle, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Color3.fromRGB(160, 165, 175) }):Play()
        TweenService:Create(TextoDesc, TweenInfo.new(0.2), { Text = CONFIG.MensajeEstado }):Play()
        TweenService:Create(BotonActivar, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(35, 40, 50) }):Play()
    end
end


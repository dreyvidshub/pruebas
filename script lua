local function LeerKeyGuardada()
	if not readfile then return nil end
	local ok, contenido = pcall(readfile, KEY_FILE)
	if ok and type(contenido) == "string" then
		local limpio = contenido:gsub("%s+", "")
		if #limpio > 0 then return limpio end
	end
	return nil
end

local function GuardarKey(k)
	if not writefile then return false end
	local ok = pcall(writefile, KEY_FILE, tostring(k))
	return ok
end

local function LoadScale()
	if readfile and isfile then
		local ok, ex = pcall(isfile, "dreyvid_config_v2.txt")
		if ok and ex then
			local ok2, data = pcall(readfile, "dreyvid_config_v2.txt")
			if ok2 and data then
				local n = tonumber(data)
				if n then return math.clamp(n, 0.7, 1.15) end
			end
		end
	end
	return 1.0
end

local function SaveScale(v)
	if writefile then pcall(function() writefile("dreyvid_config_v2.txt", tostring(v)) end) end
end


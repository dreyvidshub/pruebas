local function cero(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return end
	if prompt.HoldDuration <= 0 then return end
	if originalHolds[prompt] == nil then
		originalHolds[prompt] = prompt.HoldDuration
	end
	pcall(function() prompt.HoldDuration = 0 end)
end

table.insert(conexiones, PromptService.PromptShown:Connect(cero))
table.insert(conexiones, Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("ProximityPrompt") then cero(d) end
end))
for _, d in ipairs(Workspace:GetDescendants()) do
	if d:IsA("ProximityPrompt") then cero(d) end
end

local SavedTouches = {}
local SavedTransparency = {}

local function HidePart(p)
	if not p or not p:IsA("BasePart") then return end
	if SavedTransparency[p] == nil then
		SavedTransparency[p] = {
			Transparency = p.Transparency,
			LocalTransparencyModifier = p.LocalTransparencyModifier,
		}
	end
	pcall(function()
		p.Transparency = 1
		p.LocalTransparencyModifier = 1
	end)
end

local function MakeTrapInvisible(trap)
	if not trap or not trap.Parent then return end
	local invisibles = {}
	if trap:IsA("BasePart") then
		HidePart(trap)
		invisibles[#invisibles + 1] = trap
	end
	for _, d in ipairs(trap:GetDescendants()) do
		if d:IsA("BasePart") then
			HidePart(d)
			invisibles[#invisibles + 1] = d
		elseif d:IsA("Decal") or d:IsA("Texture") then
			if SavedTransparency[d] == nil then
				SavedTransparency[d] = { Transparency = d.Transparency }
			end
			pcall(function() d.Transparency = 1 end)
			invisibles[#invisibles + 1] = d
		elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
			pcall(function() d.Enabled = false end)
		elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
			pcall(function() d.Enabled = false end)
		end
	end
	task.spawn(function()
		while trap and trap.Parent do
			for _, p in ipairs(invisibles) do
				if p.Parent then
					pcall(function()
						if p:IsA("BasePart") then
							p.Transparency = 1
							p.LocalTransparencyModifier = 1
						elseif p:IsA("Decal") or p:IsA("Texture") then
							p.Transparency = 1
						end
					end)
				end
			end
			RunService.Heartbeat:Wait()
		end
	end)
end

local function DisableTrapTouch(part)
	if not part or not part:IsA("BasePart") then return end
	if SavedTouches[part] == nil then
		SavedTouches[part] = part.CanTouch
	end
	pcall(function() part.CanTouch = false end)
end

local function ProcessTrap(trap)
	if not trap or not trap.Parent then return end
	if trap:IsA("BasePart") then DisableTrapTouch(trap) end
	for _, d in ipairs(trap:GetDescendants()) do
		if d:IsA("BasePart") then DisableTrapTouch(d) end
	end
	MakeTrapInvisible(trap)
end

for _, trap in ipairs(CollectionService:GetTagged("PlacedTrap")) do
	ProcessTrap(trap)
end

CollectionService:GetInstanceAddedSignal("PlacedTrap"):Connect(function(trap)
	task.defer(function() ProcessTrap(trap) end)
end)

local function getFloorY(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ign = {carpeta}
	if LocalPlayer.Character then table.insert(ign, LocalPlayer.Character) end
	params.FilterDescendantsInstances = ign
	local hit = Workspace:Raycast(pos, Vector3.new(0, -2000, 0), params)
	return hit and hit.Position.Y or pos.Y
end

local function getHRP()

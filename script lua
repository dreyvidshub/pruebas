task.wait(0.15)

local okIntegridad = activarIntegridad(ScreenGui)

if okIntegridad then
    print("[Dreyvid Hub] 🛡️ Sistema de integridad ACTIVADO")
else
    warn("[Dreyvid Hub] ⚠️ No se pudo activar la integridad")
end

-- Actualiza el contador cada segundo
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(1)
        if TextoReparaciones and TextoReparaciones.Parent then
            local n = Integrity.reparaciones
            if n > 0 then
                TextoReparaciones.Text = "🛡️ Reparaciones: " .. tostring(n)
                TextoReparaciones.TextColor3 = Color3.fromRGB(255, 180, 60)
            else
                TextoReparaciones.Text = "🛡️ Protección: activa (0 intentos)"
                TextoReparaciones.TextColor3 = Color3.fromRGB(100, 180, 255)
            end
        end
    end
end)

print("[Dreyvid Hub] GUI cargada correctamente. " .. CONFIG.Version)

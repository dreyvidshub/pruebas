local function crearBotonEnlace(nombre, texto, color, link, orden)
    local boton = new("TextButton", {
        Name = nombre,
        Size = UDim2.new(0.5, -5, 1, 0),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Text = texto,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        LayoutOrder = orden,
        Parent = ContenedorEnlaces,
    }, {
        new("UICorner", { CornerRadius = UDim.new(0, 8) }),
        new("UIStroke", {
            Color = Color3.fromRGB(255, 255, 255),
            Thickness = 1,
            Transparency = 0.85,
        }),
    })

    boton.MouseEnter:Connect(function()
        TweenService:Create(boton, TweenInfo.new(0.15),
            { BackgroundTransparency = 0 }):Play()
    end)
    boton.MouseLeave:Connect(function()
        TweenService:Create(boton, TweenInfo.new(0.15),
            { BackgroundTransparency = 0.2 }):Play()
    end)

    boton.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(link)
            local textoOrig = boton.Text
            boton.Text = "✅ ¡Copiado!"
            task.wait(1.2)
            if boton and boton.Parent then
                boton.Text = textoOrig
            end
        else
            print("[Dreyvid Hub] Link " .. nombre .. ": " .. link)
        end
    end)

    return boton
end


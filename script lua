local function GetIconUrl(icon)
    if type(icon) == "number" then return "rbxassetid://" .. tostring(icon) end
    if type(icon) == "string" and #icon > 0 then
        if string.find(icon, "^rbxasset", 1) then return icon end
        if string.find(icon, "^%d+$") then return "rbxassetid://" .. icon end
        return "rbxassetid://" .. icon
    end
    return ""
end

local function GetPetInfo(cat)
    if not cat then return nil end
    local e = Catalog[tostring(cat)]
    if not e then
        return { name = tostring(cat), earning = 0, icon = "",
                 rarity = "Common", rarityColor = C.GreyDim }
    end
    local name = e.DisplayName or e._id or tostring(cat)
    local earning = tonumber(e.EarningRate) or 0
    local icon = GetIconUrl(e.Icon)
    local rarity = "Common"
    local rarityColor = C.GreyDim
    if type(e.Rarity) == "table" then
        rarity = e.Rarity.DisplayName or e.Rarity._id or "Common"
        if typeof(e.Rarity.Color) == "Color3" then rarityColor = e.Rarity.Color end
    elseif type(e.Rarity) == "string" then
        rarity = e.Rarity
    end
    return { name = name, earning = earning, icon = icon,
             rarity = rarity, rarityColor = rarityColor }
end

local function FormatMoney(n)
    if n >= 1e12 then return string.format("%.2fT", n/1e12) end
    if n >= 1e9 then return string.format("%.2fB", n/1e9) end
    if n >= 1e6 then return string.format("%.2fM", n/1e6) end
    if n >= 1e3 then return string.format("%.1fK", n/1e3) end
    return string.format("%d", math.floor(n))
end

local function getList()
    local list = {}
    local ok, res = pcall(function()
        return require(ReplicatedStorage.Client.EggState).ReadFieldEggs()
    end)
    if not ok or type(res) ~= "table" then return list end
    local records = res.Records or res
    for _, rec in pairs(records) do
        if type(rec) == "table" and (rec.State == "Slot" or rec.State == "Dropped") then
            local info = GetPetInfo(rec.AssetCategory)
            if info then
                local scale = tonumber(rec.AssetScale) or 1
                local muts = type(rec.Mutations) == "table" and rec.Mutations or {}
                local value = info.earning * scale * (1 + #muts * 0.25)
                local pos = nil
                if typeof(rec.BottomCFrame) == "CFrame" then
                    pos = rec.BottomCFrame.Position
                elseif typeof(rec.BottomCFrame) == "Vector3" then
                    pos = rec.BottomCFrame
                end
                table.insert(list, {
                    uid = rec.Uid, name = info.name, icon = info.icon,
                    rarity = info.rarity, rarityColor = info.rarityColor,
                    scale = scale, value = value, pos = pos, muts = #muts,
                })
            end
        end
    end
    table.sort(list, function(a, b) return a.value > b.value end)
    return list
end

local function getPosFromRead(uid)
    local ok, res = pcall(function()
        return require(ReplicatedStorage.Client.EggState).ReadFieldEggs()
    end)
    if not ok or type(res) ~= "table" then return nil end
    local records = res.Records or res
    for _, rec in pairs(records) do
        if type(rec) == "table" and tostring(rec.Uid) == tostring(uid) then
            if typeof(rec.BottomCFrame) == "CFrame" then
                return rec.BottomCFrame.Position, rec.State, rec.CarrierUserId
            elseif typeof(rec.BottomCFrame) == "Vector3" then
                return rec.BottomCFrame, rec.State, rec.CarrierUserId
            end
        end
    end
    return nil
end

local FLIGHT_ANIM_IDS = { "110637848614810", "126476030340764" }

local AnimState = {
    Saved = nil,
    Tracks = {},
    AnimateScript = nil,
    WasEnabled = true,
}

local function applyFlightAnim()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end

    local animate = char:FindFirstChild("Animate")
    if animate and animate:IsA("LocalScript") then
        AnimState.AnimateScript = animate
        AnimState.WasEnabled = animate.Enabled
        animate.Enabled = false
    end

    pcall(function()
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
            t:Stop(0.15)
        end
    end)

    for _, id in ipairs(FLIGHT_ANIM_IDS) do
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. id
        local ok, track = pcall(function() return animator:LoadAnimation(a) end)
        if ok and track then
            track.Priority = Enum.AnimationPriority.Action4
            track.Looped = true
            pcall(function() track:Play(0.2, 1, 1) end)
            table.insert(AnimState.Tracks, track)
        end
    end
end

local function removeFlightAnim()
    for _, t in ipairs(AnimState.Tracks) do
        pcall(function() t:Stop(0.2) end)
    end
    table.clear(AnimState.Tracks)

    if AnimState.AnimateScript and AnimState.AnimateScript.Parent then
        pcall(function()
            AnimState.AnimateScript.Enabled = AnimState.WasEnabled
        end)
    end
    AnimState.AnimateScript = nil
end


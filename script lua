local function tryRequire(...)
	local segs = {...}
	local ok, result = pcall(function()
		local m = ReplicatedStorage
		for _, seg in ipairs(segs) do
			m = m:WaitForChild(seg, 3)
			if not m then return nil end
		end
		return require(m)
	end)
	return ok and result or nil
end


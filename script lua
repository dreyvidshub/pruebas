local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- =====================================================
-- CONFIG
-- =====================================================
local Buy = {
    Enabled = false,
    Radius = 30,
    Count = 0,
    Status = "Esperando...",
    Keybind = Enum.KeyCode.N,
}

local Sell = {
    Enabled = false,
    Count = 0,
    Interval = 0.2,
    Keybind = Enum.KeyCode.M,
    Status = "Sin base",
}

-- =====================================================
-- AUTO BUY
-- =====================================================
local function getRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getBuyPrompts()
    local list = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local at = (obj.ActionText or ""):lower()
            if at:find("purchase") or at:find("buy") or at:find("comprar") then
                local p = obj.Parent
                local pos
                if p and p:IsA("Attachment") then
                    pos = p.WorldPosition
                elseif p and p:IsA("BasePart") then
                    pos = p.Position
                elseif p and p.Parent and p.Parent:IsA("BasePart") then
                    pos = p.Parent.Position
                end
                if pos then
                    table.insert(list, { prompt = obj, pos = pos })
                end
            end
        end
    end
    return list
end

local function tryBuy(data)
    if not data or not data.prompt or not data.prompt.Parent then return false end
    local prompt = data.prompt
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 100
    end)
    local ok = pcall(function() fireproximityprompt(prompt, 0) end)
    if not ok then
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.02)
            prompt:InputHoldEnd()
        end)
    end
    return true
end

local lastBuyScan = 0
RunService.Heartbeat:Connect(function()
    if not Buy.Enabled then return end
    local now = tick()
    if now - lastBuyScan < 0.5 then return end
    lastBuyScan = now

    local root = getRoot()
    if not root then
        Buy.Status = "Sin personaje"
        return
    end

    local best, bestDist = nil, Buy.Radius
    for _, item in ipairs(getBuyPrompts()) do
        local d = (item.pos - root.Position).Magnitude
        if d < bestDist then
            bestDist = d
            best = item
        end
    end

    if not best then
        Buy.Status = "Nada cerca"
        return
    end

    Buy.Status = string.format("Comprando (%.1fm)", bestDist)
    if tryBuy(best) then
        Buy.Count += 1
        task.wait(0.05)
    end
end)

-- =====================================================
-- AUTO SELL — Detección de TU base (3 métodos)
-- =====================================================
local function isMyPlotBySign(plot)
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return false end
    local sg = sign:FindFirstChildWhichIsA("SurfaceGui", true)
    local tl = sg and sg:FindFirstChildWhichIsA("TextLabel", true)
    if not tl or not tl.Text then return false end
    local low = tl.Text:lower()
    local name = LocalPlayer.Name:lower()
    local dn = (LocalPlayer.DisplayName or ""):lower()
    if low:find(name, 1, true) then return true end
    if dn ~= "" and low:find(dn, 1, true) then return true end
    return false
end

local function isMyPlotByName(plot)
    local n = plot.Name:lower()
    local name = LocalPlayer.Name:lower()
    if n == name then return true end
    if n:find(name, 1, true) then return true end
    return false
end

local function isMyPlotByOwner(plot)
    -- Algunos juegos ponen el dueño en un atributo o en un ValueObject
    local ownerAttr = plot:GetAttribute("Owner")
    if ownerAttr then
        if ownerAttr == LocalPlayer or ownerAttr == LocalPlayer.Name or ownerAttr == LocalPlayer.UserId then
            return true
        end
    end
    -- Buscar un ObjectValue / StringValue llamado Owner / Player
    for _, child in ipairs(plot:GetDescendants()) do
        if child:IsA("ObjectValue") and (child.Name == "Owner" or child.Name == "Player") then
            if child.Value == LocalPlayer then return true end
        elseif child:IsA("StringValue") and (child.Name == "Owner" or child.Name == "PlayerName") then
            if child.Value == LocalPlayer.Name then return true end
        end
    end
    return false
end

local function getMyPlot()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        if isMyPlotBySign(plot) or isMyPlotByName(plot) or isMyPlotByOwner(plot) then
            return plot
        end
    end
    return nil
end

local function sellAll()
    local plot = getMyPlot()
    if not plot then
        Sell.Status = "Sin base"
        return 0
    end
    Sell.Status = "Vendiendo en " .. plot.Name
    local ap = plot:FindFirstChild("AnimalPodiums")
    if not ap then return 0 end
    local n = 0
    for _, podium in ipairs(ap:GetChildren()) do
        for _, d in ipairs(podium:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled then
                local at = (d.ActionText or ""):lower()
                if at:find("sell") or at:find("vender") then
                    pcall(function()
                        d.HoldDuration = 0
                        fireproximityprompt(d, 0)
                    end)
                    n += 1
                    task.wait(0.02)
                end
            end
        end
    end
    return n
end

local lastSell = 0
RunService.Heartbeat:Connect(function()
    if not Sell.Enabled then return end
    local now = tick()
    if now - lastSell < Sell.Interval then return end
    lastSell = now
    local n = sellAll()
    if n > 0 then Sell.Count += n end
end)


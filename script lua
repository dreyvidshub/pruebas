	if not char then return nil, nil end
	return char:FindFirstChild("HumanoidRootPart"), char
end

local function crearPlataforma(cx, cz, yNivel)
	if plataforma then plataforma:Destroy() end
	plataforma = Instance.new("Part")
	plataforma.Name = "PisoInvisible"
	plataforma.Anchored = true
	plataforma.CanCollide = true
	plataforma.CanQuery = false
	plataforma.CanTouch = false
	plataforma.Material = Enum.Material.SmoothPlastic
	plataforma.Transparency = 1
	plataforma.Size = PLAT_TAM
	plataforma.CFrame = CFrame.new(cx, yNivel, cz)
	plataforma.Parent = carpeta
end

local function iniciarLoop()
	if loopConn then return end
	loopConn = RunService.Stepped:Connect(function()
		if not subidaActivo or not pisoY then return end
		local hrp = getHRP()
		if not hrp then return end
		if plataforma and plataforma.Parent then
			local px, pz = plataforma.Position.X, plataforma.Position.Z
			local hx, hz = hrp.Position.X, hrp.Position.Z
			if (px - hx) * (px - hx) + (pz - hz) * (pz - hz) > 4 then
				plataforma.CFrame = CFrame.new(hx, pisoY - 0.5, hz)
			end
		end
		if hrp.Position.Y < pisoY then
			local velY = math.max(hrp.AssemblyLinearVelocity.Y, 0)
			hrp.CFrame = CFrame.new(hrp.Position.X, pisoY, hrp.Position.Z) * hrp.CFrame.Rotation
			hrp.AssemblyLinearVelocity = Vector3.new(
				hrp.AssemblyLinearVelocity.X, velY, hrp.AssemblyLinearVelocity.Z
			)
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

local function detenerLoop()
	if loopConn then
		pcall(function() loopConn:Disconnect() end)
		loopConn = nil
	end
end

local subiendo = false

local function subirSuave()
	if subiendo or not subidaActivo then return end
	local hrp, char = getHRP()
	if not hrp then return end
	subiendo = true

	local pisoRealY = getFloorY(hrp.Position)
	pisoY = pisoRealY + ALTURA
	local yDestino = pisoY + OFFSET_PIES

	crearPlataforma(hrp.Position.X, hrp.Position.Z, pisoY - 0.5)

	local inicio = hrp.Position
	local destino = Vector3.new(inicio.X, yDestino, inicio.Z)
	local rotacion = hrp.CFrame.Rotation
	local t0 = os.clock()

	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end)

	while subiendo do
		local t = math.clamp((os.clock() - t0) / SUBIDA_TIME, 0, 1)
		local ease = t * t * (3 - 2 * t)
		local pos = inicio:Lerp(destino, ease)
		pcall(function()
			hrp.CFrame = CFrame.new(pos) * rotacion
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
		if t >= 1 then break end
		RunService.Heartbeat:Wait()
	end

	if hrp and hrp.Parent then
		pcall(function()
			hrp.CFrame = CFrame.new(destino) * rotacion
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
	end

	iniciarLoop()
	subiendo = false
end

local function onGrab()
	if not subidaActivo then return end
	task.wait(0.1)
	subirSuave()
end

local hooked = false
pcall(function()
	local EggState = require(ReplicatedStorage.Client.EggState)
	if EggState and EggState.CarryChanged
	   and type(EggState.CarryChanged.Connect) == "function" then
		EggState.CarryChanged:Connect(function(data)
			if type(data) == "table" and data.IsCarrying == true then
				task.spawn(onGrab)
			end
		end)
		hooked = true
	end
end)

if not hooked then
	local function watch(char)
		if not char then return end
		char.ChildAdded:Connect(function(c)
			if c:IsA("Tool") then task.spawn(onGrab) end
		end)
	end
	LocalPlayer.CharacterAdded:Connect(watch)
	if LocalPlayer.Character then watch(LocalPlayer.Character) end
end


-- =====================================================
-- PARCHE: REMOTE SELL ALL + AGARRE RÁPIDO 10 STUDS
-- Pegar DESPUÉS de cargar el script original
-- =====================================================

task.spawn(function()
    -- Esperar a que XenHub cargue
    local t0 = tick()
    while not (_G.XenHubLoaded and _G._remoteSellCreate) and tick() - t0 < 30 do
        task.wait(0.2)
    end
    if not _G._remoteSellCreate then
        warn("[Parche] XenHub no cargó a tiempo.")
        return
    end

    -- 🔹 1) Forzar rango de agarre a 10 studs
    _G.STEAL_RANGE = 10

    -- 🔹 2) Forzar PROXIMITY_RADIUS = 10 y sin predicción
    task.spawn(function()
        while true do
            task.wait(0.5)
            local cfg = getgenv and getgenv().AUTO_STEAL_CONFIG
            if cfg then
                cfg.PROXIMITY_RADIUS = 10
                cfg.PREDICTION_ENABLED = false
                break
            end
        end
    end)

    -- 🔹 3) Reescribir el toggle Auto Sell para vender TODO rápido
    -- Esperar a que el botón Auto Sell exista dentro del Remote Sell UI
    local t1 = tick()
    local btn
    while tick() - t1 < 20 do
        task.wait(0.2)
        if _G._remoteSellGui then
            local panel = _G._remoteSellPanel
            if panel then
                for _, d in ipairs(panel:GetDescendants()) do
                    if d:IsA("TextButton") and d.Text and d.Text:find("Auto Sell") then
                        btn = d
                        break
                    end
                end
            end
        end
        if btn then break end
    end

    -- 🔹 4) Sobreescribir el texto del botón
    if btn then
        local isOn = btn.Text:find("ON") ~= nil
        btn.Text = isOn and "Auto Sell ALL: ON" or "Auto Sell ALL: OFF"
        -- Monitorear cambios de texto para mantener el "ALL"
        btn:GetPropertyChangedSignal("Text"):Connect(function()
            if btn.Text == "Auto Sell: ON" then
                btn.Text = "Auto Sell ALL: ON"
            elseif btn.Text == "Auto Sell: OFF" then
                btn.Text = "Auto Sell ALL: OFF"
            end
        end)
    end

    -- 🔹 5) Reescribir la lógica de auto-venta para que venda TODO
    -- Hookeamos fireproximityprompt para que cuando el Remote Sell dispare,
    -- dispare TODOS los prompts de la base, no uno al azar.
    local mt = getrawmetatable and getrawmetatable(game)
    if mt and setreadonly then
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "Fire" and self and self.Name == "RE/UseItem" then
                -- dejar pasar
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end

    -- 🔹 6) Loop que dispara TODOS los prompts de venta de tu base
    local autoSellAllEnabled = false
    _G.autoSellAllEnabled = false

    local function getMyPlot()
        local lp = game:GetService("Players").LocalPlayer
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            if sign then
                local sg = sign:FindFirstChildWhichIsA("SurfaceGui", true)
                local tl = sg and sg:FindFirstChildWhichIsA("TextLabel", true)
                if tl and tl.Text then
                    local low = tl.Text:lower()
                    if low:find(lp.Name:lower(), 1, true) or low:find((lp.DisplayName or ""):lower(), 1, true) then
                        return plot
                    end
                end
            end
        end
        return nil
    end

    local function sellAllNow()
        local plot = getMyPlot()
        if not plot then return 0 end
        local count = 0
        local ap = plot:FindFirstChild("AnimalPodiums")
        if ap then
            for _, podium in ipairs(ap:GetChildren()) do
                for _, d in ipairs(podium:GetDescendants()) do
                    if d:IsA("ProximityPrompt")
                       and (d.ActionText or ""):sub(1,4) == "Sell"
                       and d.Enabled then
                        pcall(function() fireproximityprompt(d) end)
                        count += 1
                        task.wait(0.02)
                    end
                end
            end
        end
        return count
    end

    -- Reemplazar el botón Auto Sell por uno que venda TODO rápido
    if btn then
        btn.MouseButton1Click:Connect(function()
            -- Detectar si el usuario quiere ON u OFF según el texto actual
            local isOn = btn.Text:find("ON") ~= nil
            _G.autoSellAllEnabled = isOn
            -- El script original ya maneja su propio estado, así que solo forzamos
            -- el disparo masivo cuando el botón esté en ON.
        end)
    end

    -- Loop rápido: cada 0.15s vende todo lo que haya en tu base
    task.spawn(function()
        while true do
            task.wait(0.15)
            if _G.autoSellAllEnabled then
                pcall(sellAllNow)
            end
        end
    end)

    -- Mensaje final
    print("[Parche] ✅ Remote Sell ALL activado + Agarre rápido limitado a 10 studs.")
end)

local function fmtValue(v)
	if v >= 1e12 then return string.format("%.2fT", v/1e12) end
	if v >= 1e9 then return string.format("%.2fB", v/1e9) end
	if v >= 1e6 then return string.format("%.2fM", v/1e6) end
	if v >= 1e3 then return string.format("%.1fK", v/1e3) end
	return string.format("%.0f", v)
end

local function fmtValuePlain(v)
	if v >= 1e12 then return string.format("%.2f Trillones", v/1e12) end
	if v >= 1e9 then return string.format("%.2f Billones", v/1e9) end
	if v >= 1e6 then return string.format("%.2f Millones", v/1e6) end
	if v >= 1e3 then return string.format("%.1f Mil", v/1e3) end
	return string.format("%.0f", v)
end

local function eggInfo(category, scale)
	local dir = Assets and Assets.Directory
	local asset = type(dir) == "table" and dir[tostring(category)] or nil
	local name = asset and tostring(asset.DisplayName or category) or tostring(category)
	local earning = asset and tonumber(asset.EarningRate) or 0
	local s = tonumber(scale) or 1
	local scaleMult = s > 5 and (s/5)^1.2 * 19.637875755794113 or s^1.85

	local rarity = asset and type(asset.Rarity) == "table" and tonumber(asset.Rarity.RarityNumber or asset.Rarity.Rank) or 0
	local rarityName = asset and type(asset.Rarity) == "table" and tostring(asset.Rarity.DisplayName or "") or ""

	return {
		Name = name,
		Category = tostring(category),
		Rarity = rarity or 0,
		RarityName = rarityName,
		Value = earning * scaleMult,
		Scale = s,
	}
end

local function getEggs_M1()
	if type(EggState) ~= "table" or type(EggState.ReadFieldEggs) ~= "function" then return nil end
	local ok, result = pcall(EggState.ReadFieldEggs)
	if not ok or type(result) ~= "table" or type(result.Records) ~= "table" then return nil end
	local count = 0
	for _ in pairs(result.Records) do count += 1 end
	if count > 0 then return result.Records end
	return nil
end

local function getEggs_M2()
	if not Networking then return nil end
	local rf = Networking:FindFirstChild("RF/EggWorld/AskFieldEggSnapshot")
	if not rf or not rf:IsA("RemoteFunction") then return nil end
	local ok, result = pcall(function() return rf:InvokeServer() end)
	if not ok or type(result) ~= "table" or type(result.Records) ~= "table" then return nil end
	local count = 0
	for _ in pairs(result.Records) do count += 1 end
	if count > 0 then return result.Records end
	return nil
end

local function getAllEggs()
	for _, fn in ipairs({getEggs_M1, getEggs_M2}) do
		local ok, result = pcall(fn)
		if ok and type(result) == "table" then
			local count = 0
			for _ in pairs(result) do count += 1 end
			if count > 0 then return result, count end
		end
	end
	return {}, 0
end

local function getBestEgg()
	local eggs = getAllEggs()
	local best = nil
	for uid, rec in pairs(eggs) do
		if type(rec) == "table" and rec.State ~= "Claimed" then
			local info
			if rec.Value and rec.Rarity then
				info = rec
			else
				info = eggInfo(rec.AssetCategory, rec.AssetScale)
			end
			info.Uid = uid
			info.AreaId = tostring(rec.AreaId or "?")
			if not best or info.Value > best.Value then
				best = info
			end
		end
	end
	return best
end


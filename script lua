local function CreateAuraLayer(parent, sizeX, sizeY, posX, posY, zIndex)
	local glow = Instance.new("Frame")
	glow.Size = UDim2.new(0, sizeX, 0, sizeY)
	glow.Position = UDim2.new(0.5, posX, 0.5, posY)
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.BackgroundColor3 = Color3.fromRGB(60, 140, 255)
	glow.BackgroundTransparency = 0.85
	glow.BorderSizePixel = 0
	glow.ZIndex = zIndex
	glow.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = glow
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 140, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 100, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 220, 255)),
	})
	grad.Rotation = 45
	grad.Parent = glow
	return glow, grad
end

local function CreateRay(parent, sizeX, sizeY, posX, posY, rotation, color, zIndex)
	local ray = Instance.new("Frame")
	ray.Size = UDim2.new(0, sizeX, 0, sizeY)
	ray.Position = UDim2.new(0.5, posX, 0.5, posY)
	ray.AnchorPoint = Vector2.new(0.5, 0.5)
	ray.BackgroundColor3 = color
	ray.BackgroundTransparency = 0.5
	ray.BorderSizePixel = 0
	ray.Rotation = rotation
	ray.ZIndex = zIndex
	ray.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = ray
	return ray
end


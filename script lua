-- ============================================================
-- HELPER
-- ============================================================
local function new(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, c in ipairs(children or {}) do
        c.Parent = inst
    end
    return inst
end

-- ============================================================
-- SISTEMA DE INTEGRIDAD (inline)
-- ============================================================
local Integrity = {
    activo = false,
    restaurando = false,
    registros = {},
    conexiones = {},
    hijosConocidos = {},
    guardName = "DreyvidGuard_" .. tostring(math.random(100000, 999999)),
    reparaciones = 0,
}

local function leerPropiedad(inst, prop)
    local ok, valor = pcall(function() return inst[prop] end)
    return ok and valor or nil
end

local function escribirPropiedad(inst, prop, valor)
    pcall(function() inst[prop] = valor end)
end

local function guardarPropiedades(inst)
    local props = {}

    if inst:IsA("ScreenGui") then
        props.ResetOnSpawn = inst.ResetOnSpawn
        props.IgnoreGuiInset = inst.IgnoreGuiInset
        props.DisplayOrder = inst.DisplayOrder
        props.Enabled = inst.Enabled
    end

    if inst:IsA("GuiObject") then
        props.Size = inst.Size
        props.Position = inst.Position
        props.AnchorPoint = inst.AnchorPoint
        props.BackgroundColor3 = inst.BackgroundColor3
        props.BackgroundTransparency = inst.BackgroundTransparency
        props.BorderSizePixel = inst.BorderSizePixel
        props.ZIndex = inst.ZIndex
        props.Visible = inst.Visible
        props.Rotation = inst.Rotation
    end

    if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        props.Text = inst.Text
        props.TextColor3 = inst.TextColor3
        props.TextSize = inst.TextSize
        props.TextTransparency = inst.TextTransparency
        props.Font = inst.Font
        props.TextScaled = inst.TextScaled
        props.TextWrapped = inst.TextWrapped
    end

    if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
        props.Image = inst.Image
        props.ImageColor3 = inst.ImageColor3
        props.ImageTransparency = inst.ImageTransparency
        props.ScaleType = inst.ScaleType
    end

    if inst:IsA("UIStroke") then
        props.Color = inst.Color
        props.Thickness = inst.Thickness
        props.Transparency = inst.Transparency
    end

    if inst:IsA("UICorner") then
        props.CornerRadius = inst.CornerRadius
    end

    return props
end

local function registrar(inst, padreOriginal)
    if not inst then return nil end

    local props = guardarPropiedades(inst)
    if not next(props) then return nil end

    local registro = {
        instancia = inst,
        propiedades = props,
        padre = padreOriginal or inst.Parent,
    }
    table.insert(Integrity.registros, registro)

    table.insert(Integrity.conexiones, inst.Changed:Connect(function(prop)
        if not Integrity.activo or Integrity.restaurando then return end
        if props[prop] == nil then return end

        local actual = leerPropiedad(inst, prop)
        if actual ~= props[prop] then
            Integrity.reparaciones += 1
            Integrity.restaurando = true
            escribirPropiedad(inst, prop, props[prop])
            Integrity.restaurando = false
        end
    end))

    if registro.padre then
        table.insert(Integrity.conexiones, inst.AncestryChanged:Connect(function()
            if not Integrity.activo or Integrity.restaurando then return end
            if inst.Parent == registro.padre then return end

            Integrity.reparaciones += 1
            Integrity.restaurando = true
            pcall(function() inst.Parent = registro.padre end)
            Integrity.restaurando = false
        end))
    end

    return registro
end

local function repararTodo()
    if not Integrity.activo or Integrity.restaurando then return end
    Integrity.restaurando = true

    for _, reg in ipairs(Integrity.registros) do
        local inst = reg.instancia
        if not inst or not inst.Parent then
            if reg.padre and reg.padre.Parent then
                pcall(function() inst.Parent = reg.padre end)
            end
        else
            for prop, valor in pairs(reg.propiedades) do
                local actual = leerPropiedad(inst, prop)
                if actual ~= valor then
                    Integrity.reparaciones += 1
                    escribirPropiedad(inst, prop, valor)
                end
            end
        end
    end

    Integrity.restaurando = false
end

local function activarIntegridad(gui)
    if not gui or not gui.Parent then
        warn("[Integrity] GUI inválida")
        return false
    end

    -- Limpia conexiones previas
    for _, conn in ipairs(Integrity.conexiones) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Integrity.conexiones)
    table.clear(Integrity.registros)
    table.clear(Integrity.hijosConocidos)
    Integrity.reparaciones = 0

    registrar(gui, gui.Parent)

    for _, desc in ipairs(gui:GetDescendants()) do
        registrar(desc, desc.Parent)
    end

    for _, hijo in ipairs(gui:GetChildren()) do
        Integrity.hijosConocidos[hijo] = true
    end

    table.insert(Integrity.conexiones, gui.ChildAdded:Connect(function(hijo)
        if not Integrity.activo or Integrity.restaurando then return end
        if Integrity.hijosConocidos[hijo] then return end
        Integrity.reparaciones += 1
        pcall(function() hijo:Destroy() end)
    end))

    table.insert(Integrity.conexiones, gui.ChildRemoved:Connect(function(hijo)
        if not Integrity.activo or Integrity.restaurando then return end
        if not Integrity.hijosConocidos[hijo] then return end
        Integrity.reparaciones += 1
        Integrity.restaurando = true
        pcall(function() hijo.Parent = gui end)
        Integrity.restaurando = false
    end))

    Integrity.activo = true

    pcall(function()
        RunService:UnbindFromRenderStep(Integrity.guardName)
    end)
    RunService:BindToRenderStep(Integrity.guardName,
        Enum.RenderPriority.Last.Value + 500,
        repararTodo
    )

    return true
end

local function desactivarIntegridad()
    Integrity.activo = false

    for _, conn in ipairs(Integrity.conexiones) do
        pcall(function() conn:Disconnect() end)
    end

    table.clear(Integrity.conexiones)
    table.clear(Integrity.registros)
    table.clear(Integrity.hijosConocidos)

    pcall(function()
        RunService:UnbindFromRenderStep(Integrity.guardName)
    end)
end


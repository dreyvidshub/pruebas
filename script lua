local function crearBotonEnlace(nombre, texto, color, link, orden)
    local boton = new("TextButton", {
        Name = nombre,
        Size = UDim2.new(0.5, -5, 1, 0),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Text = texto,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        LayoutOrder = orden,
        Parent = ContenedorEnlaces,
    }, {
        new("UICorner", { CornerRadius = UDim.new(0, 8) }),
        new("UIStroke", { Color = Color3.fromRGB(255, 255, 255), Thickness = 1, Transparency = 0.85 }),
    })

    boton.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(link)
            local orig = boton.Text
            boton.Text = "✅ ¡Copiado!"
            task.wait(1.2)
            if boton and boton.Parent then boton.Text = orig end
        else
            print("[Dreyvid Hub] " .. link)
        end
    end)
    return boton
end


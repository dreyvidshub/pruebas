-- Keybinds
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Buy.Keybind then
        setBuy(not Buy.Enabled)
    elseif input.KeyCode == Sell.Keybind then
        setSell(not Sell.Enabled)
    end
end)


	local MIN_SCALE = 0.7
	local MAX_SCALE = 1.15

	local function applyScale(scale, save)
		AntiUIScale.Scale = scale
		FlyUIScale.Scale = scale
		MiniAntiUIScale.Scale = scale
		MiniFlyUIScale.Scale = scale

		local pct = (scale - MIN_SCALE) / (MAX_SCALE - MIN_SCALE)
		pct = math.clamp(pct, 0, 1)
		SliderFill.Size = UDim2.new(pct, 0, 1, 0)
		SliderKnob.Position = UDim2.new(pct, -9, 0.5, -9)
		SizeValueLabel.Text = tostring(math.floor(scale * 100 + 0.5)) .. "%"

		if save then SaveScale(scale) end
	end

	local initialPct = (GLOBAL_SCALE - MIN_SCALE) / (MAX_SCALE - MIN_SCALE)
	SliderFill.Size = UDim2.new(math.clamp(initialPct, 0, 1), 0, 1, 0)
	SliderKnob.Position = UDim2.new(math.clamp(initialPct, 0, 1), -9, 0.5, -9)
	SizeValueLabel.Text = tostring(math.floor(GLOBAL_SCALE * 100 + 0.5)) .. "%"
	MiniAntiUIScale.Scale = GLOBAL_SCALE
	MiniFlyUIScale.Scale = GLOBAL_SCALE

	SliderBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local function update(save)
				local mp = UserInputService:GetMouseLocation()
				local rel = math.clamp((mp.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
				local newScale = MIN_SCALE + (MAX_SCALE - MIN_SCALE) * rel
				applyScale(newScale, save)
			end
			update(false)
			local moveConn = UserInputService.InputChanged:Connect(function(ic)
				if ic.UserInputType == Enum.UserInputType.MouseMovement or ic.UserInputType == Enum.UserInputType.Touch then
					update(false)
				end
			end)
			local endConn = UserInputService.InputEnded:Connect(function(ie)
				if ie == input then
					update(true)
					moveConn:Disconnect()
					endConn:Disconnect()
				end
			end)
		end
	end)


-- Envia un unico mensaje "hola" a tres webhooks de Discord.
-- Coloca este Script en ServerScriptService de tu propia experiencia.
-- Activa Game Settings > Security > Allow HTTP Requests.
-- Estos webhooks se compartieron en el chat: rótalos en Discord despues de probar.

local HttpService = game:GetService("HttpService")
local WEBHOOK_URLS = {
    "https://discord.com/api/webhooks/1560450586242195487/TTDLC0G8FacFVW0SmiBezfS7RMhroE-hQlYYmwHycV7F4rq1wmavrgoErWv5yAyd3D8p",
    "https://discord.com/api/webhooks/1558542287750037585/LZIBkA8ixTNF8h-K6LRfuHdQjwkQbl6cw2mvdBNCOECfmfPQSXK7BlDLVMHuu4eaDXBG",
    "https://discord.com/api/webhooks/1560450713534857287/l_d25EDgkRNw2RAbL2bSwqU3Y8OU8vDFMs0AdnW5oI1oWfqubJ2PMNIauLNPYvj8tEO-",
}

local payload = HttpService:JSONEncode({
    content = "hola",
    allowed_mentions = { parse = {} },
})

for index, webhookUrl in ipairs(WEBHOOK_URLS) do
    local ok, result = pcall(function()
        return HttpService:RequestAsync({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payload,
        })
    end)

    if not ok then
        warn(string.format("HolaDiscord: webhook %d fallo: %s", index, tostring(result)))
    elseif not result.Success then
        warn(string.format("HolaDiscord: webhook %d respondio HTTP %s: %s",
            index, tostring(result.StatusCode), tostring(result.Body)))
    else
        print(string.format("HolaDiscord: mensaje enviado al webhook %d.", index))
    end
end

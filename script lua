local parent = gethui and gethui() or game:GetService("CoreGui")
if parent:FindFirstChild("AutoBuySellGui") then parent.AutoBuySellGui:Destroy() end

local sg = Instance.new("ScreenGui")
sg.Name = "AutoBuySellGui"
sg.ResetOnSpawn = false
sg.Parent = parent

local function makePanel(title, yPos, color)
    local f = Instance.new("Frame")
    f.Size = UDim2.fromOffset(210, 110)
    f.Position = UDim2.fromOffset(20, yPos)
    f.BackgroundColor3 = Color3.fromRGB(15, 17, 23)
    f.BorderSizePixel = 0
    f.Active = true
    f.Draggable = true
    f.Parent = sg
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 12)
    local st = Instance.new("UIStroke", f)
    st.Color = color or Color3.fromRGB(90, 120, 160)

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 0, 20)
    t.Position = UDim2.new(0, 0, 0, 6)
    t.BackgroundTransparency = 1
    t.Text = title
    t.TextColor3 = Color3.fromRGB(240, 244, 255)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.Parent = f

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 32)
    b.Position = UDim2.new(0, 10, 0, 30)
    b.BackgroundColor3 = Color3.fromRGB(40, 25, 30)
    b.Text = "OFF"
    b.TextColor3 = Color3.fromRGB(230, 120, 120)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.AutoButtonColor = false
    b.Parent = f
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1, -10, 0, 14)
    info.Position = UDim2.new(0, 5, 0, 66)
    info.BackgroundTransparency = 1
    info.Text = "..."
    info.TextColor3 = Color3.fromRGB(140, 170, 220)
    info.Font = Enum.Font.GothamMedium
    info.TextSize = 10
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.TextTruncate = Enum.TextTruncate.AtEnd
    info.Parent = f

    local keyInfo = Instance.new("TextLabel")
    keyInfo.Size = UDim2.new(1, 0, 0, 12)
    keyInfo.Position = UDim2.new(0, 0, 1, -16)
    keyInfo.BackgroundTransparency = 1
    keyInfo.Text = ""
    keyInfo.TextColor3 = Color3.fromRGB(110, 130, 170)
    keyInfo.Font = Enum.Font.GothamMedium
    keyInfo.TextSize = 9
    keyInfo.Parent = f

    return f, b, info, keyInfo
end

-- Panel BUY
local buyFrame, buyBtn, buyInfo, buyKey = makePanel("AUTO BUY", 20, Color3.fromRGB(90, 140, 220))
buyKey.Text = "Toggle: N"

local function setBuy(on)
    Buy.Enabled = on
    if on then
        buyBtn.Text = "ON"
        buyBtn.BackgroundColor3 = Color3.fromRGB(20, 45, 35)
        buyBtn.TextColor3 = Color3.fromRGB(100, 230, 160)
    else
        buyBtn.Text = "OFF"
        buyBtn.BackgroundColor3 = Color3.fromRGB(40, 25, 30)
        buyBtn.TextColor3 = Color3.fromRGB(230, 120, 120)
    end
end

buyBtn.MouseButton1Click:Connect(function() setBuy(not Buy.Enabled) end)

task.spawn(function()
    while sg.Parent do
        buyInfo.Text = string.format("Compras: %d · %s", Buy.Count, Buy.Status)
        task.wait(0.3)
    end
end)

